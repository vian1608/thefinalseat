# Server Configuration
NODE_ENV=development
PORT=5001
FRONTEND_URL=http://localhost:3000

# ─── Supabase ────────────────────────────────────────────────
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SECRET_KEY=your_supabase_secret_key

# ─── Twenty CRM ──────────────────────────────────────────────
# Keep disabled until the Twenty workspace, custom objects, and API key exist.
TWENTY_SYNC_ENABLED=false
# Cloud: https://api.twenty.com
# Self-hosted: https://crm.thefinalseat.com
TWENTY_BASE_URL=https://api.twenty.com
TWENTY_API_KEY=your_scoped_twenty_api_key
TWENTY_WEBHOOK_SECRET=your_twenty_webhook_secret
TWENTY_REQUEST_TIMEOUT_MS=15000
# These are the plural API names generated by your Twenty workspace schema.
TWENTY_BOOKINGS_OBJECT=tfsBookings
TWENTY_FLIGHT_SEGMENTS_OBJECT=tfsFlightSegments
TWENTY_PAYMENT_SPLITS_OBJECT=tfsPaymentSplits

# ─── Email — Resend ───────────────────────────────────────────
RESEND_API_KEY=your_resend_api_key
RESEND_FROM=The Final Seat LLC <onboarding@resend.dev>

# ─── Stripe Payment Gateway ──────────────────────────────────
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
STRIPE_MOCK_MODE=true

# ─── PayPal Payment Gateway ──────────────────────────────────
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id_here

# ─── SerpAPI ─────────────────────────────────────────────────
SERPAPI_API_KEY=your_serpapi_api_key

# ─── Admin ───────────────────────────────────────────────────
ADMIN_EMAIL=admin@thefinalseat.com
ADMIN_PASSWORD=your_admin_password

# ─── JWT ─────────────────────────────────────────────────────
JWT_SECRET=your-secret-key-change-this-in-production
JWT_EXPIRES_IN=7d
